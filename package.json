{
  "name": "frame11-webflow-kit",
  "version": "0.3.1",
  "description": "A small, reusable TypeScript toolkit for behavior in Webflow projects.",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler pages deploy dist --project-name frame11-webflow-kit",
    "preview": "wrangler pages dev dist"
  },
  "devDependencies": {
    "jsdom": "^27.4.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.3",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "webflow",
    "typescript",
    "custom-code"
  ],
  "license": "MIT",
  "dependencies": {
    "vanilla-cookieconsent": "3.1.0"
  }
}
